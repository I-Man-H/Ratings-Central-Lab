{
  // Static-assets-only Worker. There is no server-side code: Wrangler just
  // uploads the built files. This also stops Wrangler trying to auto-configure
  // itself from Vite, which is what failed the deploy.
  "name": "ratings-central-lab",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
{
  "observability": {
    "enabled": false
  }
}
  }

}
